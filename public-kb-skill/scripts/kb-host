#!/bin/bash
set -euo pipefail

die() {
  printf '%s\n' "$1" >&2
  exit 64
}

shell_quote() {
  local value=${1-}
  local out="'"
  local prefix

  while [[ "$value" == *"'"* ]]; do
    prefix=${value%%"'"*}
    out+=$prefix
    out+="'\"'\"'"
    value=${value#*\'}
  done

  out+=$value
  out+="'"
  printf '%s' "$out"
}

reject_selector_args() {
  local arg
  for arg in "$@"; do
    case "$arg" in
      --project|--project=*|--workspace|--workspace=*|--db|--db=*)
        die "kb-host does not accept board selectors; remove '$arg' and retry."
        ;;
      --registry|--registry=*|--all-boards|--all-boards=*)
        die "kb-host does not route registry or cross-board scope flag '$arg'."
        ;;
    esac
  done
}

allow_registry_command() {
  case $1 in
    version|v|init|workspace|w|ws|dashboard|dash|doctor|audit|backup|restore|rule|r|serve|schema|mcp)
      return 0
      ;;
    deploy|import|tag|archive|search|search-rebuild|subscription|stale|todo|task|t|story|s|handoff|h|attention|att|attn|claim|checkpoint|cp|heartbeat|hb|release|rel|context|ctx|events|ev|note|n|sitrep|sr|watch)
      die 'kb-host is for registry-owned commands only; use kb-board for board-owned commands.'
      ;;
    *)
      die "kb-host does not route unknown command '$1'."
      ;;
  esac
}

board_exists() {
  local needle=$1
  local i
  for i in "${!BOARD_IDS[@]}"; do
    if [[ "${BOARD_IDS[$i]}" = "$needle" ]]; then
      return 0
    fi
  done
  return 1
}

lookup_host() {
  local needle=$1
  local i
  local found=0
  for i in "${!BOARD_IDS[@]}"; do
    if [[ "${BOARD_HOME_HOSTS[$i]}" = "$needle" ]]; then
      if [[ "$found" -eq 0 ]]; then
        BOARD_HOME_HOST=${BOARD_HOME_HOSTS[$i]}
        BOARD_SSH_TARGET=${BOARD_SSH_TARGETS[$i]}
        BOARD_EXPECTED_REMOTE_HOST=${BOARD_EXPECTED_REMOTE_HOSTS[$i]}
        BOARD_KB_EXEC=${BOARD_KB_EXECS[$i]}
        found=1
        continue
      fi

      if [[ "${BOARD_SSH_TARGETS[$i]}" != "$BOARD_SSH_TARGET" || "${BOARD_EXPECTED_REMOTE_HOSTS[$i]}" != "$BOARD_EXPECTED_REMOTE_HOST" || "${BOARD_KB_EXECS[$i]}" != "$BOARD_KB_EXEC" ]]; then
        die "kb-host: conflicting host mapping: $needle"
      fi
    fi
  done

  [[ "$found" -eq 1 ]] || return 1
  return 0
}

load_table() {
  local table_file=$1

  [[ -r "$table_file" ]] || die "kb-host: routing table is not readable: $table_file"

  local line board home_host ssh_target expected_remote kb_exec extra
  local loaded=0

  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" || "$line" == \#* ]] && continue

    IFS=$'\t' read -r board home_host ssh_target expected_remote kb_exec extra <<<"$line"
    if [[ -n "${extra-}" || -z "${board-}" || -z "${home_host-}" || -z "${ssh_target-}" || -z "${expected_remote-}" || -z "${kb_exec-}" ]]; then
      die "kb-host: malformed routing row: $line"
    fi

    case "$kb_exec" in
      /*) ;;
      *) die "kb-host: KB executable path must be absolute: $kb_exec" ;;
    esac

    if board_exists "$board"; then
      die "kb-host: duplicate board mapping: $board"
    fi

    BOARD_IDS+=("$board")
    BOARD_HOME_HOSTS+=("$home_host")
    BOARD_SSH_TARGETS+=("$ssh_target")
    BOARD_EXPECTED_REMOTE_HOSTS+=("$expected_remote")
    BOARD_KB_EXECS+=("$kb_exec")
    loaded=1
  done <"$table_file"

  [[ "$loaded" -eq 1 ]] || die "kb-host: routing table has no rows: $table_file"
}

host=${1-}
command=${2-}

if [[ -z "$host" || -z "$command" ]]; then
  die 'usage: kb-host BOARD_HOME_HOST COMMAND [ARGS...]'
fi

shift 2

reject_selector_args "$@"
allow_registry_command "$command"

declare -a BOARD_IDS
declare -a BOARD_HOME_HOSTS
declare -a BOARD_SSH_TARGETS
declare -a BOARD_EXPECTED_REMOTE_HOSTS
declare -a BOARD_KB_EXECS

script_dir=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
table_file=${KB_HOSTS_TABLE:-"$script_dir/../hosts.tsv"}
kb_bin=
ssh_bin=${KB_SSH_BIN:-ssh}

load_table "$table_file"

if ! lookup_host "$host"; then
  die "kb-host: unknown host: $host"
fi

kb_bin=$BOARD_KB_EXEC

case "$kb_bin" in
  /*) ;;
  *) die "kb-host: KB executable path must be absolute: $kb_bin" ;;
esac

current_host=$(/bin/hostname)

if [[ "$current_host" = "$BOARD_HOME_HOST" ]]; then
  exec "$kb_bin" "$command" "$@"
fi

remote_cmd="if [ \"\$(/bin/hostname)\" = $(shell_quote "$BOARD_EXPECTED_REMOTE_HOST") ]; then exec $(shell_quote "$kb_bin") $(shell_quote "$command")"
for arg in "$@"; do
  remote_cmd+=" $(shell_quote "$arg")"
done
remote_cmd+="; else printf '%s\n' 'kb-host: remote hostname mismatch' >&2; exit 69; fi"

exec "$ssh_bin" -- "$BOARD_SSH_TARGET" "$remote_cmd"
