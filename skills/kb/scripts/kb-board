#!/bin/bash
set -euo pipefail

die() {
  printf '%s\n' "$1" >&2
  exit 64
}

project=${1-}
kb_command=${2-}

if [ -z "${project}" ] || [ -z "${kb_command}" ]; then
  die 'usage: kb-board PROJECT KB_COMMAND [ARGS...]'
fi

for arg in "$@"; do
  case "$arg" in
    r|rule)
      if [ "$arg" = "$kb_command" ]; then
        die 'kb-board is for board-owned commands only; use hax-kb directly for registry rules (for example: hax-kb r ls --json).'
      fi
      ;;
    # Registry-wide commands answer about every board, so a project selector
    # names a subject they do not address. Kanban refuses it rather than
    # discarding it, because a receipt computed about something else reads as
    # an answer about the board you named. Refuse here too, so the wrapper
    # that injects the selector is what explains it.
    init|serve|schema|mcp|doctor|backup|restore|audit|dashboard|dash|w|ws|workspace)
      if [ "$arg" = "$kb_command" ]; then
        die "kb-board injects --project, and '$kb_command' addresses the registry and every board in it, not one board; use hax-kb directly (for example: hax-kb $kb_command --json)."
      fi
      ;;
    --project|--project=*|--workspace|--workspace=*|--db|--db=*)
      die "kb-board injects exactly one project selector; remove '$arg' and retry."
      ;;
  esac
done

shift 2

script_dir=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

exec "$script_dir/hax-kb" --project "$project" "$kb_command" "$@"
